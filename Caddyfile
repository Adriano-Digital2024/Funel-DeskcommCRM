# Caddy com TLS internal para funcionar atrás do Cloudflare Tunnel
{
        email {$ACME_EMAIL}
}

{$DOMAIN} {
        tls internal
        encode gzip

        route {
                @waha_global path /api/v1/webhooks/waha
                respond @waha_global 403

                @agentrun path /api/internal/agents/run*
                reverse_proxy @agentrun app:3000 {
                        transport http {
                                read_timeout 320s
                                write_timeout 320s
                        }
                }

                reverse_proxy app:3000
        }
}
